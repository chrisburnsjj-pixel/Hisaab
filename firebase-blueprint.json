{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and personal finance preferences in Hisaab",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user ID matching Firebase Authentication UID"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name"
        },
        "email": {
          "type": "string",
          "description": "User's email address"
        },
        "currency": {
          "type": "string",
          "description": "Currency symbol preference (e.g. PKR, USD, EUR, GBP)"
        },
        "customCategories": {
          "type": "array",
          "description": "Custom transaction categories added by the user"
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Monthly target spending budget"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was created (server timestamp)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was last updated (server timestamp)"
        }
      },
      "required": ["userId", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income or expense record created by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Transaction unique document ID"
        },
        "userId": {
          "type": "string",
          "description": "Owning user UID"
        },
        "title": {
          "type": "string",
          "description": "Title or description of the transaction"
        },
        "amount": {
          "type": "number",
          "description": "Monetary value of the transaction (positive number)"
        },
        "type": {
          "type": "string",
          "enum": ["INCOME", "EXPENSE"],
          "description": "Type of transaction"
        },
        "category": {
          "type": "string",
          "description": "Category name (e.g. Salary, Food, Bills, Shopping, Travel, Health, Entertainment, Other)"
        },
        "date": {
          "type": "string",
          "description": "Transaction date string YYYY-MM-DD"
        },
        "note": {
          "type": "string",
          "description": "Optional notes or remarks"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp via FieldValue.serverTimestamp()"
        }
      },
      "required": ["userId", "title", "amount", "type", "category", "date", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User's financial income and expense ledger entries"
    }
  }
}
