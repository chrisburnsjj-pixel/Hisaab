rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema Validation Helpers
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
             (!('customCategories' in data) || (data.customCategories is list && data.customCategories.size() <= 50)) &&
             (!('monthlyBudget' in data) || (data.monthlyBudget is number && data.monthlyBudget >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.amount is number && data.amount > 0 &&
             data.type in ['INCOME', 'EXPENSE'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.date is string && data.date.size() >= 8 && data.date.size() <= 30 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'currency', 'customCategories', 'monthlyBudget', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'currency', 'customCategories', 'monthlyBudget', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Transactions Subcollection
      match /transactions/{transactionId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(transactionId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'amount', 'type', 'category', 'date', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'title', 'amount', 'type', 'category', 'date', 'note', 'createdAt', 'updatedAt']) &&
                         isValidTransaction(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(transactionId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTransaction(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'type', 'category', 'date', 'note', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(transactionId);
      }
    }
  }
}
